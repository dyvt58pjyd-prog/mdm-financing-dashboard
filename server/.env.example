PORT=5001

# --- LIVE FIREBASE CONFIGURATION (OPTIONAL) ---
# When provided, server connects directly to your live Google Firebase project.
# If omitted, the server automatically boots into the high-fidelity Sandbox Simulator.

# Option A: Path to serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# Option B: Raw JSON string of serviceAccountKey
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "your-project-id", ...}'

# Firebase Realtime Database URL
# FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
